# Copy to .env and fill in. .env is git-ignored; never commit real values.
#   cp .env.example .env

# ---- XBot core ---------------------------------------------------------------
# dev | test | prod
XBOT_ENV=dev
# Signs the dashboard session cookie and encrypts X tokens at rest. 32+ characters.
# Generate with:  cd backend && uv run xbot keygen
XBOT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
# Password for the single-user dashboard login (also used by the xbot CLI).
XBOT_DASHBOARD_PASSWORD=change-me
# Async SQLAlchemy URL. Default points at the docker-compose Postgres on host port 5433.
XBOT_DATABASE_URL=postgresql+psycopg://xbot:xbot@127.0.0.1:5433/xbot
XBOT_TIMEZONE=Asia/Kolkata
XBOT_HOST=127.0.0.1
XBOT_PORT=8000
XBOT_PUBLIC_URL=http://127.0.0.1:8000

# ---- Model provider ----------------------------------------------------------
# openrouter | anthropic | mock   (mock is for development only; outputs are labelled [MOCK])
XBOT_LLM_PROVIDER=openrouter
# openrouter: vendor/model id, e.g. google/gemini-3.5-flash-lite (~$0.60/month at one run a day)
# anthropic:  claude-sonnet-5 (~$3/month) or claude-opus-5 (~$7.50/month)
XBOT_LLM_MODEL=google/gemini-3.5-flash-lite

# https://openrouter.ai/keys  -> create a key and add credits   (XBOT_LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# https://console.anthropic.com -> Settings -> API Keys           (XBOT_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---- Publishing to X ---------------------------------------------------------
# mock | x   Keep "mock" until your X account is connected; "x" posts for real.
XBOT_PUBLISHER=mock
# https://developer.x.com -> your app -> Keys and tokens -> OAuth 2.0 Client ID and Client Secret
# (not the API Key/Secret and not the Bearer Token). App permissions must be "Read and write".
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match the callback URL configured in the X app's "User authentication settings" exactly.
XBOT_X_REDIRECT_URI=http://127.0.0.1:8000/api/x/callback

# ---- GitHub (optional) -------------------------------------------------------
# Fine-grained token with "Public repositories (read-only)". Raises the rate limit 60 -> 5000/h.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
