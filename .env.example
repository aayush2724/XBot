# ---- XBot core ---------------------------------------------------------------
# dev | test | prod
XBOT_ENV=dev
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Used to sign the dashboard session cookie and to encrypt X tokens at rest.
XBOT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
# Password for the single-user dashboard login.
XBOT_DASHBOARD_PASSWORD=change-me
# Async SQLAlchemy URL. Default points at the docker-compose Postgres on host port 5433.
XBOT_DATABASE_URL=postgresql+psycopg://xbot:xbot@127.0.0.1:5433/xbot
XBOT_TIMEZONE=Asia/Kolkata
XBOT_HOST=127.0.0.1
XBOT_PORT=8000
XBOT_PUBLIC_URL=http://127.0.0.1:8000

# ---- Providers ---------------------------------------------------------------
# anthropic | mock   (mock is for development only and is shown as a banner in the UI)
XBOT_LLM_PROVIDER=anthropic
# x | mock
XBOT_PUBLISHER=mock

# ---- External credentials (leave blank until you have them) ------------------
# https://console.anthropic.com  -> API keys
ANTHROPIC_API_KEY=
# Optional. Fine-grained token, public repo read is enough. Raises GitHub rate limit 60 -> 5000/h.
GITHUB_TOKEN=
# https://developer.x.com -> your app -> Keys and tokens -> OAuth 2.0 Client ID and Client Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match the callback URL configured in the X app's "User authentication settings".
XBOT_X_REDIRECT_URI=http://127.0.0.1:8000/api/x/callback
